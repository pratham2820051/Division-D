# App

APP_ENV=development

APP_HOST=0.0.0.0

APP_PORT=8000

CORS_ORIGINS=["http://localhost:3000"]



# LLM (Groq — symptom extraction)
# Vector store (Developer A)
GROQ_API_KEY=

GROQ_MODEL=llama-3.3-70b-versatile

GROQ_MAX_TOKENS=1024

GROQ_TEMPERATURE=0.3

USE_GROQ_EXTRACTION=false



# Vector store (planned RAG)

CHROMA_PERSIST_DIR=./vector_store/chroma

CHROMA_COLLECTION=ruralvet_livestock

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2



# Database

DATABASE_URL=sqlite:///./database/ruralvet.db



# Voice

WHISPER_MODEL=base

WHISPER_DEVICE=cpu

# auto | sarvam — auto uses Sarvam only when SARVAM_API_KEY is set (no Whisper/mock chain)
# whisper | faster-whisper | mock — dev/offline only
VOICE_STT_PROVIDER=sarvam

SARVAM_API_KEY=

SARVAM_STT_MODEL=saaras:v3

SARVAM_STT_MODE=transcribe

SARVAM_STT_TIMEOUT_SECONDS=25

TTS_ENGINE=edge-tts

TTS_VOICE=hi-IN-SwaraNeural



# Translation

# auto | groq | libretranslate | mock — auto uses Groq when GROQ_API_KEY is set
TRANSLATION_PROVIDER=auto

DEFAULT_LANGUAGE=en

SUPPORTED_LANGUAGES=en,hi,mr,kn,ta,te



# Alerts

SMS_PROVIDER=console

WHATSAPP_ENABLED=false

# Optional: pre-fill WhatsApp share to this vet (country code + number, digits only)
# Example India: 919876543210
VET_WHATSAPP_PHONE=



# Memory

SESSION_TTL_HOURS=24

MAX_CONTEXT_MESSAGES=20



# Feature flags

ENABLE_VOICE=true

ENABLE_RAG=true

ENABLE_ALERTS=true

